<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Listing added</title>
  <link rel="stylesheet" href="/output.css">
</head>
<body class="min-h-screen bg-stone-50 text-stone-800">
  <header class="border-b border-stone-200 bg-white">
     <nav class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
      <a href="/" class="text-2xl font-bold tracking-tight text-airbnb">Mybnb</a>
      <div class="flex gap-3">
        <a href="/user/rent" class="rounded-full px-4 py-2 text-sm font-medium text-stone-700 hover:bg-stone-100">Rent</a>
        <a href="/host/add-bnb" class="rounded-full bg-airbnb px-4 py-2 text-sm font-semibold text-white hover:bg-rose-600">Add Home</a>
        <a href="/host/Favourites" class="rounded-full bg-airbnb px-4 py-2 text-sm font-semibold text-white hover:bg-rose-600">Favourites</a>
        <a href="/host/homes" class="rounded-full bg-airbnb px-4 py-2 text-sm font-semibold text-white hover:bg-rose-600">MY Home-List</a>
        <a href="/host/myBookings" class="rounded-full bg-airbnb px-4 py-2 text-sm font-semibold text-white hover:bg-rose-600">-my bookings</a>
      </div>
    </nav>
  </header>

    <main class="mx-auto max-w-5xl px-6 py-16">
    <h1 class="mb-2 text-3xl font-bold text-stone-900">favHome listed by you on Mybnb.</h1>
    <% if (favHome.length === 0) { %>
      <div class="rounded-2xl border border-dashed border-stone-300 bg-white p-12 text-center">
        <p class="mb-4 text-stone-500">No favourites  yet. Add the first to list the list.</p>
        <a href="/user/rent" class="inline-block rounded-full bg-airbnb px-6 py-2 font-semibold text-white hover:bg-rose-600">Register a Fav</a>
      </div>
    <% } else { %>
      <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <% favHome.forEach(home => { %>
          <li class="rounded-2xl border border-stone-200 bg-white p-6 shadow-sm">
            <div class="mb-3 h-32 rounded-xl bg-gradient-to-br from-rose-100 to-orange-100 "></div>
            <div class="space-y-2">
              <h2 class="text-lg font-semibold text-stone-900"><%= home.housename %></h2>
              <p class="text-base font-medium text-airbnb">Price : <%=home.price %> Rs</p>
              <p class="text-sm text-airbnb">Location : <%=home.location %></p>
              <p class="text-sm text-stone-900">theme :<%=home.theme %></p>
              <p class="mt-3 text-xs font-medium uppercase tracking-wide text-green-600">Available to rent</p>
              <button onclick="addfav('<%=home.id%>')"> Add To Favourite</button>
            </div>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </main>
</body>
</html>
