<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Browse BNBs</title>
  <link rel="stylesheet" href="/output.css">
</head>
<body class="min-h-screen bg-stone-50 text-stone-800">
  <header class="border-b border-stone-200 bg-white">
    <nav class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
      <a href="/" class="text-2xl font-bold tracking-tight text-airbnb">Mybnb</a>
      <div class="flex gap-3">
        <a href="/user/rent" class="rounded-full bg-stone-100 px-4 py-2 text-sm font-medium text-stone-800">Rent</a>
        <a href="/host/add-bnb" class="rounded-full bg-airbnb px-4 py-2 text-sm font-semibold text-white hover:bg-rose-600">Host</a>
      </div>
    </nav>
  </header>

  <main class="mx-auto max-w-5xl px-6 py-16">
    <h1 class="mb-2 text-3xl font-bold text-stone-900">Browse our BNBs</h1>
    <p class="mb-10 text-stone-600">Homes listed by hosts on Mybnb.</p>
    <% if (homes.length === 0) { %>
      <div class="rounded-2xl border border-dashed border-stone-300 bg-white p-12 text-center">
        <p class="mb-4 text-stone-500">No stays yet. Be the first to list a home.</p>
        <a href="/host/add-bnb" class="inline-block rounded-full bg-airbnb px-6 py-2 font-semibold text-white hover:bg-rose-600">Register a BNB</a>
      </div>
    <% } else { %>
      <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <% homes.forEach(home => { %>
          <li class="rounded-2xl border border-stone-200 bg-white p-6 shadow-sm">
            <div class="mb-3 h-32 rounded-xl bg-gradient-to-br from-rose-100 to-orange-100 "></div>
            <div class="space-y-2">
              <h2 class="text-lg font-semibold text-stone-900"><%= home.housename %></h2>
              <p class="text-base font-medium text-airbnb"><%=home.price %> Rs</p>
              <p class="text-sm text-stone-600"><%=home.location %></p>
              <p class="mt-3 text-xs font-medium uppercase tracking-wide text-green-600">Available to rent</p>
            </div>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </main>
</body>
</html>
