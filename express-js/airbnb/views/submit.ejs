<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Listing added</title>
  <link rel="stylesheet" href="/output.css">
</head>
<body class="min-h-screen bg-stone-50 text-stone-800">
  <header class="border-b border-stone-200 bg-white">
     <nav class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
      <a href="/" class="text-2xl font-bold tracking-tight text-airbnb">Mybnb</a>
      <div class="flex gap-3">
        <a href="/user/rent" class="rounded-full px-4 py-2 text-sm font-medium text-stone-700 hover:bg-stone-100">Rent</a>
        <a href="/host/add-bnb" class="rounded-full bg-airbnb px-4 py-2 text-sm font-semibold text-white hover:bg-rose-600">Add Home</a>
        <a href="/host/Favourites" class="rounded-full bg-airbnb px-4 py-2 text-sm font-semibold text-white hover:bg-rose-600">Favourites</a>
        <a href="/host/myHomes" class="rounded-full bg-airbnb px-4 py-2 text-sm font-semibold text-white hover:bg-rose-600">MY Home-List</a>
        <a href="/host/myBookings" class="rounded-full bg-airbnb px-4 py-2 text-sm font-semibold text-white hover:bg-rose-600">-my bookings</a>
      </div>
    </nav>
  </header>

  <main class="mx-auto max-w-md px-6 py-24 text-center">
    <div class="rounded-2xl border border-stone-200 bg-white p-10 shadow-sm">
      <p class="mb-2 text-5xl">✓</p>
      <h1 class="mb-3 text-3xl font-bold text-stone-900">Done!</h1>
      <p class="mb-8 text-stone-600">Your BNB has been listed.</p>
      <a href="/" class="inline-block rounded-full bg-airbnb px-8 py-3 font-semibold text-white hover:bg-rose-600">Go to home</a>
    </div>
  </main>
</body>
</html>
